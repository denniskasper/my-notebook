{
  "name": "my-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && rm -rf .next/standalone/.next/static && cp -r .next/static .next/standalone/.next/static",
    "build:migrate": "esbuild src/platform/db/migrate.ts --bundle --platform=node --format=esm --target=node24 --external:pg-native --outfile=dist/migrate.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit && tsc -p .sandcastle",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "sandcastle": "pnpm sandcastle:image && tsx .sandcastle/main.ts",
    "sandcastle:image": "docker build -t sandcastle:my-notebook --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) .sandcastle",
    "test:sandcastle": "tsx --test .sandcastle/*.test.ts",
    "typecheck:sandcastle": "tsc -p .sandcastle",
    "demo:seed": "tsx src/demo/seed-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  }
}
