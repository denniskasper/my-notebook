{
  "name": "my-notebook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.13.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "scripts": {
    "sandcastle": "tsx .sandcastle/main.ts",
    "sandcastle:image": "docker build -t sandcastle:my-notebook --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) .sandcastle",
    "test:sandcastle": "tsx --test .sandcastle/*.test.ts",
    "typecheck:sandcastle": "tsc -p .sandcastle"
  }
}
