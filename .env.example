# Copy to .env for local development. `docker compose up -d` provides both databases.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/my_notebook
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/my_notebook_test
# Secret for hashing Visitor IPs (HMAC). Required in production; any 32+ characters.
IP_HASH_SECRET=
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Git commit the build runs; set by the image build, reported by /api/health.
COMMIT=
# `fake` (scripted, no key, no cost) or `real` (Claude via the API; needs ANTHROPIC_API_KEY).
LLM_MODE=fake
ANTHROPIC_API_KEY=
# Tokens a Notebook's enabled Sources may add up to.
SOURCE_TOKEN_CAP=80000
